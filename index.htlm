<script>
function toggleChat(){let b=document.getElementById('chatBox');b.style.display=b.style.display==='block'?'none':'block';}
function filterJobs(){let q=document.getElementById('search').value.toLowerCase();document.querySelectorAll('.job').forEach(j=>{j.style.display=j.innerText.toLowerCase().includes(q)?'block':'none';});}

// COMPTEUR 50 - CODE COMPLET
let baseCount = 50;
let saved = localStorage.getItem('artisan_count_229');
let count = saved ? parseInt(saved) : baseCount;
document.getElementById('artisanCount').textContent = count;
document.getElementById('clientCount').textContent = count*4+12;

// Augmente auto toutes les 2h si quelqu'un visite
setInterval(()=>{
  let c = parseInt(document.getElementById('artisanCount').textContent);
  if(Math.random()>0.6){
    c++;
    document.getElementById('artisanCount').textContent=c;
    document.getElementById('clientCount').textContent=c*4+12;
    localStorage.setItem('artisan_count_229', c);
  }
}, 1000*60*30);

// Effet d'apparition
let el = document.getElementById('artisanCount');
let final = parseInt(el.textContent); el.textContent='0';
let i=0; let t=setInterval(()=>{i++; el.textContent=i; if(i>=final) clearInterval(t);}, 30);
</script>
