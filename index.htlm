<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',sans-serif}
body{background:#080808;color:white}
.hero{text-align:center;padding:30px 15px 20px;background:linear-gradient(180deg,#1e1e1e,#080808);border-bottom:2px solid #FFC107}
.logo{font-size:34px;font-weight:900;color:#FFC107}.logo span{color:white}
.badge{background:#FFC107;color:black;padding:5px 12px;border-radius:20px;font-weight:900;font-size:11px;display:inline-block;margin:8px 0}
.live{background:rgba(37,211,102,0.15);border:1px solid #25D366;color:#25D366;padding:10px 16px;border-radius:25px;display:inline-flex;align-items:center;gap:8px;font-weight:900;font-size:13px;margin:12px auto;animation:blink 2s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:0.7}}
.dot{width:10px;height:10px;background:#25D366;border-radius:50%;display:inline-block;box-shadow:0 0 10px #25D366}
.hero h1{font-size:22px;margin:12px 0 5px}.hero p{color:#aaa;font-size:13px}
.btns{max-width:500px;margin:12px auto 0}
.btn{display:block;width:100%;padding:15px;border-radius:12px;text-decoration:none;font-weight:900;font-size:15px;margin:7px 0;text-align:center}
.btn-wa{background:#25D366;color:white}.btn-vocal{background:#1a1a1a;border:2px solid #FFC107;color:#FFC107}.btn-inscri{background:#FFC107;color:black}
.search-box{max-width:500px;margin:12px auto;padding:0 15px;position:sticky;top:0;z-index:9;background:#080808;padding:12px 15px}
.search-box input{width:100%;padding:14px 16px;border-radius:12px;border:1px solid #333;background:#151515;color:white;font-size:14px;outline:none}
.search-box input:focus{border-color:#FFC107}
.section{max-width:650px;margin:0 auto;padding:0 12px 110px}
.section h2{font-size:14px;color:#FFC107;margin:22px 5px 10px;letter-spacing:1px;border-left:3px solid #FFC107;padding-left:8px}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.job{background:#151515;border:1px solid #222;border-radius:14px;padding:14px 8px;text-align:center;text-decoration:none;color:white;display:block}
.job .icon{font-size:30px}.job h3{font-size:12px;color:#FFC107;margin:5px 0 2px;line-height:1.2}.job p{font-size:10px;color:#666}
.footer{text-align:center;padding:25px;color:#555;font-size:11px}
.chat-bubble{position:fixed;bottom:18px;right:18px;width:60px;height:60px;background:#25D366;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:28px;cursor:pointer;z-index:9999;box-shadow:0 5px 20px rgba(0,0,0,.6)}
.chat-box{position:fixed;bottom:85px;right:12px;width:300px;background:#1a1a1a;border:1px solid #333;border-radius:16px;padding:16px;display:none;z-index:9999}
.chat-box a{display:block;padding:12px;border-radius:10px;text-align:center;text-decoration:none;font-weight:900;margin-top:8px}
</style>
